#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/../.."
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export XDG_RUNTIME_DIR="$tmp/run" XDG_CONFIG_HOME="$tmp/config" XDG_DATA_HOME="$tmp/data"
export XDG_CACHE_HOME="$tmp/cache" XDG_STATE_HOME="$tmp/state"
mkdir -m 700 "$XDG_RUNTIME_DIR"
mkdir -p "$XDG_CONFIG_HOME/pipewire/pipewire.conf.d"
cp linux/tests/pipewire.conf "$XDG_CONFIG_HOME/pipewire/pipewire.conf.d/drink.conf"
mkdir -p "$XDG_DATA_HOME/applications"
# KService 6.24 indexes desktop entries via an XDG menu. A standalone
# compositor on a CI runner has no Plasma application menu installed.
export XDG_MENU_PREFIX=drink-test-
mkdir -p "$XDG_CONFIG_HOME/menus"
cat >"$XDG_CONFIG_HOME/menus/${XDG_MENU_PREFIX}applications.menu" <<'MENU'
<Menu>
    <Name>Applications</Name>
    <DefaultAppDirs/>
    <Include><All/></Include>
</Menu>
MENU
cat >"$XDG_DATA_HOME/applications/org.example.DrinkGame.desktop" <<'DESKTOP'
[Desktop Entry]
Type=Application
Name=Drink test game
Exec=true
Categories=Game;
DESKTOP
unset DISPLAY WAYLAND_SOCKET DBUS_SESSION_BUS_ADDRESS PIPEWIRE_REMOTE PIPEWIRE_RUNTIME_DIR
export WAYLAND_DISPLAY=drink-test XDG_SESSION_TYPE=wayland QT_QPA_PLATFORM=wayland
export QT_FORCE_STDERR_LOGGING=1
export XDG_CURRENT_DESKTOP=KDE QT_QPA_PLATFORMTHEME=generic DRINK_TEST_SESSION=1
# Only explicitly launched peers belong on the test bus. In particular, avoid
# activating portals and other user services against the virtual display.
cat >"$tmp/bus.conf" <<'BUS'
<busconfig>
    <type>session</type><listen>unix:tmpdir=/tmp</listen>
    <policy context="default">
        <allow own="*"/><allow send_destination="*"/><allow receive_sender="*"/>
    </policy>
</busconfig>
BUS
dbus-run-session --config-file="$tmp/bus.conf" -- bash -eu <<'SESSION'
kwin_wayland --virtual --width 960 --height 540 --output-count 2 --no-lockscreen --no-kactivities --socket "$WAYLAND_DISPLAY" >"$XDG_RUNTIME_DIR/kwin.log" 2>&1 &
wm=$!
trap 'kill "$wm" 2>/dev/null || true; wait || true' EXIT
for _ in {1..100}; do
    [[ -S "$XDG_RUNTIME_DIR/$WAYLAND_DISPLAY" ]] && break
    sleep 0.1
done
DBUS_SYSTEM_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" timeout 90 target/linux/plasma-test || { cat "$XDG_RUNTIME_DIR/"*.log >&2; exit 1; }
SESSION
