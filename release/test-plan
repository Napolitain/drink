#!/bin/bash
set -euo pipefail
plan="$(cd "$(dirname "$0")" && pwd)/plan"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
cd "$tmp"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
git init -q -b main
git config user.name Tester
git config user.email test@example.invalid
git commit --allow-empty -qm initial
first=$(git rev-parse HEAD)
today="v$(date -u +%Y.%m.%d)"
test "$("$plan" "$first" '')" = "$today"
git tag v2020.01.01
test -z "$("$plan" "$first" v2020.01.01)"
git commit --allow-empty -qm next
second=$(git rev-parse HEAD)
test "$("$plan" "$second" v2020.01.01)" = "$today"
git tag "$today"
test -z "$("$plan" "$second" "$today")"
if "$plan" "$first" ''; then echo "Accepted a conflicting tag." >&2; exit 1; fi
echo "First, unchanged, changed, repeated and conflicting release checks passed."
