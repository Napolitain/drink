#!/bin/bash
# A successful check leaves either an authenticated Drink.app or an empty stage.
set -euo pipefail
bundle=$1
stage=$2
export LC_ALL=C
releases=https://github.com/Napolitain/drink/releases
# Use public release URLs, without credentials or the GitHub API rate limit.
http=(-q --fail --silent --show-error --proto '=https' --proto-redir '=https' --connect-timeout 10 --max-time 120 --retry 2)
version_key=CFBundleShortVersionString
current=$(/usr/bin/plutil -extract "$version_key" raw "$bundle/Contents/Info.plist")
location=$(curl "${http[@]}" --head --output /dev/null --write-out '%{redirect_url}' "$releases/latest")
[[ "$location" == "$releases/tag/"* ]] || { echo "Unexpected latest-release location" >&2; exit 1; }
tag=${location#"$releases/tag/"}
[[ $tag =~ ^v[0-9]{4}\.[0-9]{2}\.[0-9]{2}$ ]] || { echo "Invalid release tag" >&2; exit 1; }
version=${tag#v}
[[ "$version" > "$current" ]] || exit 0
cd "$stage"
for file in Drink-macOS.zip Drink-macOS.zip.sig; do
    curl "${http[@]}" --location --output "$file" "$releases/download/$tag/$file"
done
/usr/bin/ssh-keygen -Y verify -f "$bundle/Contents/Resources/release-signers" \
    -I drink -n drink-macos -s Drink-macOS.zip.sig < Drink-macOS.zip
/usr/bin/ditto -x -k Drink-macOS.zip .
/usr/bin/codesign --verify --strict Drink.app
plist=Drink.app/Contents/Info.plist
identifier=$(/usr/bin/plutil -extract CFBundleIdentifier raw "$plist")
display_version=$(/usr/bin/plutil -extract "$version_key" raw "$plist")
build_version=$(/usr/bin/plutil -extract CFBundleVersion raw "$plist")
if [[ "$identifier" != io.github.napolitain.drink || "$display_version" != "$version" || "$build_version" != "$version" ]]; then
    echo "Release identity or version mismatch" >&2
    exit 1
fi
