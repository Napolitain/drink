#!/bin/bash
set -euo pipefail
cd "$(dirname "$0")/.."

export MACOSX_DEPLOYMENT_TARGET=14.2
export CXX=/usr/bin/clang++
# Keep the generated bridge header and library together even with a global Cargo target dir.
export CARGO_TARGET_DIR="$PWD/target"

mode=${1:-}
sources=(macos/main.mm)
name=Drink
identifier=io.github.napolitain.drink
if [[ -n "${DRINK_RELEASE_VERSION:-}" ]]; then
    [[ -z "$mode" ]] || { echo "Release builds take no launch options" >&2; exit 2; }
else
    case "$mode" in
        ""|--dev) name="Drink Dev"; identifier+=.dev ;;
        --smoke-test) name=DrinkSmoke; identifier+=.smoke; sources=(macos/tests/smoke.mm) ;;
        *) echo "Usage: macos/build [--dev | --smoke-test]" >&2; exit 2 ;;
    esac
    sources+=(-DDRINK_DEVELOPMENT_SESSION macos/development/Session.mm)
fi
bundle="$CARGO_TARGET_DIR/$name.app"
mkdir -p "$bundle/Contents/MacOS"
cp macos/Info.plist "$bundle/Contents/"
/usr/bin/plutil -replace CFBundleName -string "$name" "$bundle/Contents/Info.plist"
/usr/bin/plutil -replace CFBundleIdentifier -string "$identifier" "$bundle/Contents/Info.plist"
mkdir -p "$bundle/Contents/Resources"
cp macos/{fetch-update,release-signers} "$bundle/Contents/Resources/"

compile() {
    local arch=$1 lib=$2 binary=$3
    "$CXX" -arch "$arch" -std=c++17 -fobjc-arc -Os -Wall -Wextra -Werror -Wl,-dead_strip -Wl,-x \
        -I "$CARGO_TARGET_DIR/cxxbridge" -I macos macos/{BreakWindows,DrinkApp,Microphone,ReleaseUpdater}.mm "${sources[@]}" \
        "$lib/libdrink_macos_bridge.a" -framework AppKit -framework CoreAudio -framework CoreGraphics -o "$binary"
}

if [[ -n "${DRINK_RELEASE_VERSION:-}" ]]; then
    [[ "$DRINK_RELEASE_VERSION" =~ ^[0-9]{4}\.[0-9]{2}\.[0-9]{2}$ ]] || { echo "Invalid release version or build mode" >&2; exit 1; }
    for key in CFBundleVersion CFBundleShortVersionString; do
        /usr/bin/plutil -replace "$key" -string "$DRINK_RELEASE_VERSION" "$bundle/Contents/Info.plist"
    done
    /usr/bin/plutil -insert DrinkReleaseBuild -bool YES "$bundle/Contents/Info.plist"
    binaries=()
    for arch in arm64 x86_64; do
        triple="${arch/arm64/aarch64}-apple-darwin"
        cargo build --locked --release --target "$triple" -p drink-macos-bridge
        binary="$CARGO_TARGET_DIR/$triple/release/Drink"
        compile "$arch" "$CARGO_TARGET_DIR/$triple/release" "$binary"
        binaries+=("$binary")
    done
    /usr/bin/lipo -create "${binaries[@]}" -output "$bundle/Contents/MacOS/Drink"
else
    cargo build --locked --release -p drink-macos-bridge
    compile "$(uname -m)" "$CARGO_TARGET_DIR/release" "$bundle/Contents/MacOS/Drink"
fi
/usr/bin/strip -x "$bundle/Contents/MacOS/Drink"
/usr/bin/codesign --force --sign - "$bundle"
printf '%s\n' "$bundle"
if [[ -n "$mode" ]]; then
    exec "$bundle/Contents/MacOS/Drink"
fi
